// La Bulle De Vie — Prisma Schema
// Supabase/PostgreSQL backend
// Prisma 5.x / 6.x compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  client
  specialist
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

enum RefundStatus {
  none
  requested
  refunded
}

enum OrderStatus {
  pending
  paid
  shipped
  cancelled
}

enum ServiceCategory {
  massage
  energetique
  creation
}

enum DiscountType {
  percent
  fixed
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Extends Supabase auth.users — id is the same UUID from auth.users
model Profile {
  id                     String   @id
  fullName               String
  phone                  String?
  role                   UserRole @default(client)
  avatarUrl              String?
  /// Saved preference for booking form pre-fill — "cabinet" | "domicile"
  preferredLocation      String?
  /// Saved shipping address for e-commerce checkout pre-fill
  defaultShippingAddress Json?
  /// Private specialist notes about this client (dashboard only, never shown to client)
  specialistNotes        String?
  /// Notification preferences — { rappel24h, rappel2h, sms, newsletter }
  notificationPrefs      Json?
  /// Specialist only — cabinet address used as origin for travel distance calculation
  cabinetAddress         String?
  /// Specialist only — lat/lng of cabinet, cached to avoid repeated geocoding
  cabinetLat             Float?
  cabinetLng             Float?
  /// Specialist only — travel pricing config (JSON)
  /// Shape: { type: "zones" | "per_km", perKmRate?: number,
  ///           zones?: [{ maxKm: number, feeInCents: number }][],
  ///           maxDistanceKm: number }
  travelPricing          Json?
  /// Specialist only — TVA/tax settings per service type (JSON)
  /// Shape: { servicesVatRate: number, productsVatRate: number }
  /// French massage (bien-être) is typically TVA-exempt (0%) — specialist can override
  taxSettings            Json?
  /// Specialist only — weekly availability schedule (JSON)
  /// Shape: { mon/tue/wed/thu/fri/sat: { enabled: boolean, start: "09:00", end: "18:00" }, slotDurationMin: number, lunchStart?: string, lunchEnd?: string }
  weeklySchedule         Json?
  /// Specialist only — Google Calendar OAuth token bundle
  /// Shape: { access_token, refresh_token, expiry_date, scope }
  googleCalendarToken    Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  appointments  Appointment[]
  orders        Order[]
  reviews       Review[]
  giftCardsBought GiftCard[] @relation("PurchasedBy")
  giftCardsUsed   GiftCard[] @relation("RedeemedBy")

  @@map("profiles")
}

model Service {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  /// Short label shown on cards, e.g. "Signature", "Éclat"
  tagline         String?
  /// One-liner: who this service is for, e.g. "Tensions, fatigue accumulée"
  forWho          String?
  /// Hook paragraph shown on the service card and detail page header
  shortDescription  String?
  /// Extended description shown in the detail section
  longDescription   String?
  /// What happens during the main ritual step
  ritualCore        String?
  /// Duration string for the main step, e.g. "~ 50 minutes"
  ritualCoreDuration String?
  /// Array of benefit objects: [{title: string, description: string}]
  benefits        Json?
  /// Slugs of related services shown at the bottom of the detail page
  relatedSlugs    String[]
  /// Background hex color for the service card, e.g. "#2C1F14"
  bgColor         String?
  /// Display order in the catalog — lower = shown first
  displayOrder    Int             @default(0)
  description     String
  durationMinutes Int
  /// Price in euro cents (e.g. 10500 = 105.00 €)
  price           Int
  category        ServiceCategory
  isPublished     Boolean         @default(true)
  imageUrls       String[]
  /// VAT rate as integer percentage — 0 for TVA-exempt (most massage/bien-être), 20 for standard
  vatRate         Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  appointments Appointment[]
  reviews      Review[]

  @@map("services")
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  /// Date only — stored as DATE in PostgreSQL
  date      DateTime @db.Date
  /// 24h format, e.g. "09:00"
  startTime String
  /// 24h format, e.g. "10:00"
  endTime   String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  appointment Appointment?

  @@map("availability_slots")
}

model Appointment {
  id                    String            @id @default(uuid())
  /// Null for guest bookings — use guestEmail to identify the client
  clientId              String?
  serviceId             String
  /// One-to-one link to the slot — booking a slot marks it as taken
  slotId                String            @unique
  status                AppointmentStatus @default(pending)
  notes                 String?
  isFirstVisit          Boolean           @default(false)
  /// "cabinet" | "domicile"
  location              String
  /// Guest fields — populated when clientId is null
  guestName             String?
  guestEmail            String?
  guestPhone            String?
  stripePaymentIntentId String?           @unique
  refundStatus          RefundStatus      @default(none)
  /// Client address for home visits — required when location = "domicile"
  clientAddress         String?
  /// Travel surcharge in euro cents — computed from distance, added to amountPaid
  travelFee             Int               @default(0)
  /// Discount applied — FK to discount_codes if a promo code was used
  discountCodeId        String?
  /// Gift card applied — FK to gift_cards if one was used
  giftCardId            String?
  /// Total discount applied in euro cents (welcome -20%, promo code, gift card)
  discountAmount        Int               @default(0)
  /// Actual amount charged via Stripe in euro cents (servicePrice - discountAmount)
  amountPaid            Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  client       Profile?         @relation(fields: [clientId], references: [id])
  service      Service          @relation(fields: [serviceId], references: [id])
  slot         AvailabilitySlot @relation(fields: [slotId], references: [id])
  discountCode DiscountCode?    @relation(fields: [discountCodeId], references: [id])
  giftCard     GiftCard?        @relation(fields: [giftCardId], references: [id])
  review       Review?

  @@map("appointments")
}

/// Post-appointment review tied to a specific service.
/// stars is validated at the application layer (1–5).
/// Use a CHECK constraint in the migration SQL if adding via raw SQL.
model Review {
  id              String   @id @default(uuid())
  appointmentId   String   @unique
  serviceId       String
  clientId        String
  /// Must be between 1 and 5 — enforce with a DB CHECK constraint
  stars           Int
  body            String
  approved        Boolean  @default(false)
  specialistReply String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])
  client      Profile     @relation(fields: [clientId], references: [id])

  @@map("reviews")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  /// Price in euro cents
  price       Int
  stock       Int      @default(0)
  /// E.g. "Acrylique sur toile", "Aquarelle"
  medium      String
  /// E.g. "40 × 50 cm"
  dimensions  String
  imageUrl    String?
  isPublished Boolean  @default(true)
  /// VAT rate as integer percentage — typically 20% for physical products in France
  vatRate     Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id                    String      @id @default(uuid())
  /// Null for guest orders
  clientId              String?
  /// Guest fields — populated when clientId is null
  guestName             String?
  guestEmail            String?
  status                OrderStatus @default(pending)
  /// Total in euro cents
  total                 Int
  stripePaymentIntentId String?
  shippingAddress       Json?
  /// Discount applied — FK to discount_codes if a promo code was used
  discountCodeId        String?
  /// Gift card applied — FK to gift_cards if one was used
  giftCardId            String?
  /// Total discount applied in euro cents
  discountAmount        Int         @default(0)
  /// Actual amount charged via Stripe in euro cents
  amountPaid            Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  client       Profile?      @relation(fields: [clientId], references: [id])
  items        OrderItem[]
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])
  giftCard     GiftCard?     @relation(fields: [giftCardId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  /// Price snapshot at time of purchase, in euro cents
  unitPrice Int
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

/// Specialist-created promo codes (e.g. WELCOME20, SUMMER10)
model DiscountCode {
  id                    String       @id @default(uuid())
  /// Uppercase alphanumeric code, e.g. "WELCOME20"
  code                  String       @unique
  type                  DiscountType
  /// percent: 0–100, fixed: amount in euro cents
  value                 Int
  /// null = unlimited uses
  maxUses               Int?
  usedCount             Int          @default(0)
  /// Restrict to first booking only
  firstBookingOnly      Boolean      @default(false)
  /// Restrict to appointments only, orders only, or both (null = both)
  appliesTo             String?
  isActive              Boolean      @default(true)
  expiresAt             DateTime?
  createdAt             DateTime     @default(now())

  appointments Appointment[]
  orders       Order[]

  @@map("discount_codes")
}

/// Gift cards — purchased by one client, redeemable by another (or same)
model GiftCard {
  id                    String    @id @default(uuid())
  /// Uppercase code, e.g. "BDV-X4F7-2L9P"
  code                  String    @unique
  /// Original value in euro cents
  initialBalance        Int
  /// Remaining balance in euro cents (decremented on each use)
  balance               Int
  purchasedById         String?
  redeemedById          String?
  stripePaymentIntentId String?
  isActive              Boolean   @default(true)
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  redeemedAt            DateTime?

  purchasedBy  Profile?      @relation("PurchasedBy", fields: [purchasedById], references: [id])
  redeemedBy   Profile?      @relation("RedeemedBy", fields: [redeemedById], references: [id])
  appointments Appointment[]
  orders       Order[]

  @@map("gift_cards")
}

/// Newsletter subscribers — email-only opt-in list
model NewsletterSubscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  subscribedAt     DateTime @default(now())
  /// Random token used in unsubscribe links — never expose to frontend
  unsubscribeToken String   @unique @default(uuid())

  @@map("newsletter_subscribers")
}
